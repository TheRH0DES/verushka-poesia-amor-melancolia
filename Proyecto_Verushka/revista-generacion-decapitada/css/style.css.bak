/* ================================================================
   LAS VOCES QUE FLORECIERON EN LA SOMBRA
   Revista Digital — Formato Proyector / Laptop
   style.css · Dark Academia · Gótico · Literario
   ================================================================ */

/* ──────────────────────────────────────────────────────────────
   1. DESIGN TOKENS
   ────────────────────────────────────────────────────────────── */
:root {
  /* Paleta */
  --c-bg:           #080608;
  --c-bg-panel:     #0e0a0c;
  --c-surface:      #130e10;
  --c-border:       rgba(201,168,76,0.18);
  --c-border-hover: rgba(201,168,76,0.45);
  --c-red:          #8b0000;
  --c-red-lt:       #c41a1a;
  --c-gold:         #c9a84c;
  --c-gold-lt:      #e8c97e;
  --c-gold-dim:     #8a6f35;
  --c-gold-faint:   rgba(201,168,76,0.08);
  --c-text:         #ede3cf;
  --c-text-2:       #b8a88a;
  --c-text-3:       #6e5e48;
  --c-white:        #f7f2ea;

  /* Tipografía */
  --f-display:  'Cinzel Decorative', 'Cinzel', serif;
  --f-title:    'Cinzel', 'Georgia', serif;
  --f-body:     'Cormorant Garamond', 'Georgia', serif;
  --f-prose:    'Lora', 'Georgia', serif;

  /* Espacios */
  --sp-xs:  0.35rem;
  --sp-sm:  0.65rem;
  --sp-md:  1.1rem;
  --sp-lg:  1.8rem;
  --sp-xl:  2.8rem;

  /* Masthead */
  --masthead-h:  64px;

  /* Transición */
  --ease:       cubic-bezier(0.4, 0, 0.2, 1);
  --t-fast:     0.18s;
  --t-normal:   0.38s;
  --t-slow:     0.55s;

  /* Flechas */
  --arrow-size: 72px;
}

/* ──────────────────────────────────────────────────────────────
   2. RESET
   ────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  height: 100%;
  overflow: hidden;
  background: var(--c-bg);
}

body {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--c-bg);
  color: var(--c-text);
  font-family: var(--f-prose);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  /* Patrón de textura sutil en el fondo */
  background-image:
    radial-gradient(ellipse at 15% 50%, rgba(139,0,0,0.06) 0%, transparent 55%),
    radial-gradient(ellipse at 85% 30%, rgba(201,168,76,0.04) 0%, transparent 50%);
}

img, video { display: block; }
button { cursor: pointer; border: none; background: none; font-family: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 3px; }

/* ──────────────────────────────────────────────────────────────
   3. MASTHEAD — Título fijo inamovible
   ────────────────────────────────────────────────────────────── */
.masthead {
  flex-shrink: 0;
  height: var(--masthead-h);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-md);
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.98) 0%,
    rgba(8,4,6,0.95) 100%
  );
  border-bottom: 1px solid var(--c-border);
  position: relative;
  z-index: 30;
  /* Línea dorada superior decorativa */
  box-shadow:
    inset 0 -1px 0 rgba(201,168,76,0.12),
    0 2px 24px rgba(0,0,0,0.6);
}

.masthead::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--c-gold-dim) 30%, var(--c-gold) 50%, var(--c-gold-dim) 70%, transparent 100%);
}

.masthead__ornament {
  color: var(--c-gold);
  font-size: 1rem;
  opacity: 0.7;
  flex-shrink: 0;
}

.masthead__title {
  font-family: var(--f-display);
  font-size: clamp(1.1rem, 2.2vw, 1.7rem);
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--c-white);
  text-align: center;
  line-height: 1.15;
  /* Brillo dorado sutil */
  text-shadow:
    0 0 40px rgba(201,168,76,0.25),
    0 1px 3px rgba(0,0,0,0.9);
  /* user-select none para proteger el título */
  user-select: none;
  -webkit-user-select: none;
  pointer-events: none;
}

/* ──────────────────────────────────────────────────────────────
   4. INDICADOR DE PÁGINA Y PUNTOS
   ────────────────────────────────────────────────────────────── */
.page-indicator {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(0,0,0,0.7);
  border: 1px solid var(--c-border);
  border-radius: 999px;
  padding: 5px 16px;
  font-family: var(--f-title);
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  color: var(--c-gold-dim);
  backdrop-filter: blur(8px);
}

.page-indicator__sep { color: var(--c-text-3); }

.dots-nav {
  position: fixed;
  bottom: 58px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;
  display: flex;
  gap: 8px;
  align-items: center;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  border: 1px solid rgba(255,255,255,0.1);
  transition: all var(--t-normal) var(--ease);
  cursor: pointer;
}

.dot.is-active {
  background: var(--c-gold);
  border-color: var(--c-gold);
  transform: scale(1.4);
  box-shadow: 0 0 8px rgba(201,168,76,0.6);
}

.dot:hover:not(.is-active) {
  background: rgba(201,168,76,0.4);
  border-color: rgba(201,168,76,0.4);
}

/* ──────────────────────────────────────────────────────────────
   5. VIEWER — Contenedor principal tipo proyector
   ────────────────────────────────────────────────────────────── */
.viewer {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  /* Padding lateral para las flechas */
  padding: var(--sp-sm) calc(var(--arrow-size) + 16px);
}

/* ──────────────────────────────────────────────────────────────
   6. FLECHAS DE NAVEGACIÓN
   ────────────────────────────────────────────────────────────── */
.nav-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 40;
  width: var(--arrow-size);
  height: var(--arrow-size);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 5, 8, 0.75);
  border: 1px solid var(--c-border);
  color: var(--c-gold);
  transition:
    background var(--t-fast) var(--ease),
    border-color var(--t-fast) var(--ease),
    transform var(--t-fast) var(--ease),
    box-shadow var(--t-fast) var(--ease);
  backdrop-filter: blur(6px);
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

.nav-arrow--left  { left: 12px; }
.nav-arrow--right { right: 12px; }

.nav-arrow:hover {
  background: rgba(139,0,0,0.55);
  border-color: var(--c-border-hover);
  transform: translateY(-50%) scale(1.08);
  box-shadow:
    0 0 20px rgba(139,0,0,0.3),
    0 4px 24px rgba(0,0,0,0.6);
}

.nav-arrow:active {
  transform: translateY(-50%) scale(0.96);
}

.nav-arrow.is-disabled {
  opacity: 0.22;
  pointer-events: none;
}

.nav-arrow__icon {
  font-size: 2.6rem;
  line-height: 1;
  font-weight: 300;
  font-family: Georgia, serif;
  margin-top: -2px;
}

/* ──────────────────────────────────────────────────────────────
   7. CARRUSEL
   ────────────────────────────────────────────────────────────── */
.carousel {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ──────────────────────────────────────────────────────────────
   8. PÁGINA — Base
   ────────────────────────────────────────────────────────────── */
.page {
  position: absolute;
  /* Vertical (portrait) centrado en pantalla horizontal */
  height: 100%;
  /* Ratio de página: ~A4 orientación vertical */
  width: auto;
  aspect-ratio: 3/4;
  max-width: 100%;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;

  /* Marco decorativo */
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: 6px;
  box-shadow:
    0 0 0 1px rgba(0,0,0,0.5),
    0 20px 60px rgba(0,0,0,0.8),
    0 0 120px rgba(0,0,0,0.4);

  /* Estados de transición */
  opacity: 0;
  pointer-events: none;
  transform: translateX(60px) scale(0.97);
  transition:
    opacity var(--t-slow) var(--ease),
    transform var(--t-slow) var(--ease);

  /* Decoración: borde interior dorado muy sutil */
  outline: 1px solid rgba(201,168,76,0.06);
  outline-offset: -6px;
}

.page.is-active {
  opacity: 1;
  pointer-events: all;
  transform: translateX(0) scale(1);
}

/* Entrando desde la derecha */
.page.from-right {
  transform: translateX(60px) scale(0.97);
}

/* Saliendo hacia la izquierda */
.page.to-left {
  opacity: 0;
  transform: translateX(-60px) scale(0.97);
}

/* Entrando desde la izquierda */
.page.from-left {
  transform: translateX(-60px) scale(0.97);
}

/* Saliendo hacia la derecha */
.page.to-right {
  opacity: 0;
  transform: translateX(60px) scale(0.97);
}

/* ──────────────────────────────────────────────────────────────
   9. IMAGEN DE PÁGINA
   ────────────────────────────────────────────────────────────── */
.page__image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: inherit;
  background: var(--c-surface);
  /* Sin arrastre */
  -webkit-user-drag: none;
  user-select: none;
}

.page__image--contain {
  object-fit: contain;
}

/* ──────────────────────────────────────────────────────────────
   10. PORTADA — Efectos extras
   ────────────────────────────────────────────────────────────── */
.page--cover {
  box-shadow:
    0 0 0 1px rgba(201,168,76,0.15),
    0 20px 60px rgba(0,0,0,0.9),
    0 0 80px rgba(139,0,0,0.15);
}

/* Sello circular sobre portada */
.cover-seal {
  position: absolute;
  bottom: 28px;
  right: 24px;
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-seal__ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1.5px solid rgba(201,168,76,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  animation: spin-ring 20s linear infinite;
}

@keyframes spin-ring {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.cover-seal__text {
  position: absolute;
  width: 100%;
  height: 100%;
  /* Texto circular simulado con SVG */
  font-family: var(--f-title);
  font-size: 0.45rem;
  letter-spacing: 0.18em;
  color: var(--c-gold-dim);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 4px;
  text-transform: uppercase;
}

.cover-seal__center {
  font-family: var(--f-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--c-gold);
  letter-spacing: 0.06em;
  z-index: 2;
  text-shadow: 0 0 12px rgba(201,168,76,0.4);
}

/* ──────────────────────────────────────────────────────────────
   11. PÁGINAS DE VIDEO
   ────────────────────────────────────────────────────────────── */
.page--video {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(80,0,0,0.18) 0%, transparent 60%),
    var(--c-surface);
  border-color: rgba(139,0,0,0.3);
  box-shadow:
    0 0 0 1px rgba(139,0,0,0.1),
    0 0 40px rgba(139,0,0,0.1),
    0 20px 60px rgba(0,0,0,0.9);
}

.page__video-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-sm);
  padding: var(--sp-lg) var(--sp-md);
}

.page__video-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--f-title);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--c-text-2);
  padding: 5px 14px;
  background: rgba(0,0,0,0.5);
  border: 1px solid rgba(139,0,0,0.3);
  border-radius: 999px;
  backdrop-filter: blur(4px);
}

.page__video-label-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--c-red);
  animation: blink-dot 1.4s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes blink-dot {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}

.page__video {
  width: 100%;
  height: calc(100% - 60px);
  object-fit: contain;
  border-radius: 4px;
  background: #000;
  box-shadow:
    0 0 0 1px rgba(201,168,76,0.08),
    0 8px 32px rgba(0,0,0,0.7);
}

/* Controles de video estilizados */
.page__video::-webkit-media-controls-panel {
  background: linear-gradient(transparent, rgba(0,0,0,0.9));
}

/* ──────────────────────────────────────────────────────────────
   12. PÁGINAS ESPECIALES — Infografía y Opinión
   ────────────────────────────────────────────────────────────── */
.page--infografia {
  background: var(--c-bg);
  border-color: rgba(201,168,76,0.2);
  box-shadow:
    0 0 0 1px rgba(201,168,76,0.08),
    0 20px 60px rgba(0,0,0,0.9);
}

.page--opinion {
  background:
    radial-gradient(ellipse at 50% 100%, rgba(139,0,0,0.12) 0%, transparent 60%),
    var(--c-surface);
  border-color: rgba(201,168,76,0.2);
}

/* ──────────────────────────────────────────────────────────────
   13. FONDO GLOBAL — Textura de papel oscuro
   ────────────────────────────────────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255,255,255,0.008) 2px,
      rgba(255,255,255,0.008) 3px
    );
  pointer-events: none;
}

/* ──────────────────────────────────────────────────────────────
   14. ANIMACIÓN DE ENTRADA DE PÁGINA ACTIVA
   ────────────────────────────────────────────────────────────── */
@keyframes page-glow {
  from { box-shadow: 0 0 0 1px var(--c-border), 0 20px 60px rgba(0,0,0,0.8), 0 0 0px rgba(201,168,76,0); }
  to   { box-shadow: 0 0 0 1px var(--c-border), 0 20px 60px rgba(0,0,0,0.8), 0 0 30px rgba(201,168,76,0.06); }
}

.page.is-active {
  animation: page-glow 0.8s var(--ease) forwards;
}

/* ──────────────────────────────────────────────────────────────
   15. RESPONSIVE — Ajustes para distintos tamaños de pantalla
   ────────────────────────────────────────────────────────────── */

/* Proyector/pantalla grande (≥1280px) */
@media (min-width: 1280px) {
  :root {
    --arrow-size: 80px;
    --masthead-h: 70px;
  }
  .masthead__title { font-size: 1.9rem; }
  .nav-arrow__icon { font-size: 3rem; }
}

/* Laptop estándar (1024–1279px) */
@media (max-width: 1279px) and (min-width: 1024px) {
  :root { --masthead-h: 60px; }
  .masthead__title { font-size: 1.4rem; }
}

/* Pantalla pequeña o tablet (768–1023px) */
@media (max-width: 1023px) and (min-width: 768px) {
  :root {
    --masthead-h: 56px;
    --arrow-size: 56px;
  }
  .masthead__title { font-size: 1.1rem; }
  .nav-arrow__icon { font-size: 2.2rem; }
}

/* Móvil (<768px) — funcional aunque no es el destino principal */
@media (max-width: 767px) {
  :root {
    --masthead-h: 52px;
    --arrow-size: 44px;
  }
  .masthead__title { font-size: 0.88rem; letter-spacing: 0.02em; }
  .masthead__ornament { display: none; }
  .viewer { padding: 4px calc(var(--arrow-size) + 8px); }
  .nav-arrow__icon { font-size: 1.8rem; }
}

/* ──────────────────────────────────────────────────────────────
   16. ACCESIBILIDAD
   ────────────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .page,
  .nav-arrow,
  .cover-seal__ring,
  .dot { transition: none !important; animation: none !important; }
}

/* ──────────────────────────────────────────────────────────────
   17. PRINT
   ────────────────────────────────────────────────────────────── */
@media print {
  .nav-arrow, .dots-nav, .page-indicator { display: none !important; }
  .page { box-shadow: none; border: 1px solid #ccc; }
}
